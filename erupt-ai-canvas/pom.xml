<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>xyz.erupt</groupId>
        <artifactId>erupt</artifactId>
        <version>2.0.5</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>erupt-ai-canvas</artifactId>
    <name>Erupt : AI Canvas</name>
    <description>AI generated HTML view pages — describe a page in natural language, the LLM writes a self-contained HTML page that reads data through the Erupt REST API; pages are stored in the database and served as embeddable menus.</description>

    <dependencies>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-ai</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- erupt-ai declares the data layer as provided; bring it in explicitly -->
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-upms</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- Bundled Vue3 / Element Plus / axios assets referenced by generated pages -->
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-tpl-ui.element-plus</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
    </dependencies>
</project>
