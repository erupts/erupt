<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>erupt-cloud-node-vertx</artifactId>
    <name>Erupt : Cloud Node Vert.x</name>
    <description>Mounts an erupt-cloud-node-lite node on a Vert.x Web router (Vert.x 4.5 and 5)</description>
    <packaging>jar</packaging>

    <parent>
        <groupId>xyz.erupt</groupId>
        <artifactId>erupt</artifactId>
        <version>2.4.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <properties>
        <!-- the oldest line served, which Quarkus 3 ships; only API Vert.x 5 keeps is used -->
        <vertx.version>4.5.34</vertx.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Vert.x' own Netty and Jackson, not Spring Boot's -->
            <dependency>
                <groupId>io.vertx</groupId>
                <artifactId>vertx-stack-depchain</artifactId>
                <version>${vertx.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-cloud-node-lite</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
