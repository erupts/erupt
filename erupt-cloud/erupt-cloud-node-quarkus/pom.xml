<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>erupt-cloud-node-quarkus</artifactId>
    <name>Erupt : Cloud Node Quarkus</name>
    <description>Serves the application's erupt-cloud-node-lite node on Quarkus' HTTP server</description>
    <packaging>jar</packaging>

    <parent>
        <groupId>xyz.erupt</groupId>
        <artifactId>erupt</artifactId>
        <version>2.4.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <properties>
        <quarkus.version>3.40.1</quarkus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Quarkus' own Vert.x, Netty and Jackson, not Spring Boot's -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-cloud-node-vertx</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
