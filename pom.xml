<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>xyz.erupt</groupId>
    <artifactId>erupt</artifactId>
    <version>2.1.1</version>

    <packaging>pom</packaging>
    <name>Erupt : </name>
    <description>erupt common data framework pom parent</description>
    <url>https://www.erupt.xyz</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <tag>master</tag>
        <url>https://github.com/erupts/erupt</url>
        <connection>scm:git:git@github.com:erupts/erupt.git</connection>
        <developerConnection>scm:git:git@github.com:erupts/erupt.git</developerConnection>
    </scm>

    <organization>
        <name>Erupt</name>
        <url>https://www.erupt.xyz</url>
    </organization>

    <developers>
        <developer>
            <name>YuePeng</name>
            <email>erupts@126.com</email>
            <roles>
                <role>owner</role>
            </roles>
            <timezone>+8</timezone>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <erupt.groupId>xyz.erupt</erupt.groupId>
        <java.version>17</java.version>
        <langchain4j.version>1.14.1</langchain4j.version>
        <spring.boot.version>3.5.16</spring.boot.version>
        <!-- Versions converged here because several third-party jars pull different releases:
             nashorn (asm 7) vs json-smart (asm 9), kotlin-stdlib (annotations 13) vs ours, oshi vs pty4j (jna) -->
        <asm.version>9.9.1</asm.version>
        <jna.version>5.18.1</jna.version>
        <jetbrains.annotations.version>24.0.1</jetbrains.annotations.version>
        <!-- calcite 1.41 (erupt-cube-sql) needs guava 33.4.8-jre but shardingsphere pins 30.0-jre; qdrant pulls the
             android flavour. POI 5.5 needs commons-io 2.20 but calcite declares 2.15 on a shorter path -->
        <guava.version>33.4.8-jre</guava.version>
        <commons-io.version>2.20.0</commons-io.version>
    </properties>

    <modules>
        <!-- Core -->
        <module>erupt-annotation</module>
        <module>erupt-core</module>

        <!-- Data -->
        <module>erupt-data/erupt-data-jpa</module>
        <module>erupt-data/erupt-data-mongodb</module>
        <module>erupt-data/erupt-data-memory</module>
        <module>erupt-data/erupt-data-http</module>
        <module>erupt-data/erupt-data-jdbc</module>
        <module>erupt-data/erupt-data-es</module>
        <module>erupt-data/erupt-data-ldap</module>
        <module>erupt-data/erupt-data-k8s</module>
        <module>erupt-data/erupt-data-s3</module>
        <module>erupt-data/erupt-data-redis</module>
        <module>erupt-data/erupt-data-file</module>
        <module>erupt-data/erupt-data-feishu</module>
        <module>erupt-data/erupt-data-notion</module>

        <!-- UPMS / Security / Web / Misc -->
        <module>erupt-upms</module>
        <module>erupt-security</module>
        <module>erupt-admin</module>
        <module>erupt-web</module>

        <!-- Starter -->
        <module>erupt-starter/erupt-spring-boot-starter</module>
        <module>erupt-starter/erupt-spring-boot-starter-all</module>

        <!-- Template -->
        <module>erupt-tpl/erupt-tpl</module>
        <module>erupt-tpl/ant-design</module>
        <module>erupt-tpl/element-ui</module>
        <module>erupt-tpl/element-plus</module>

        <!-- AI -->
        <module>erupt-ai/erupt-ai</module>
        <module>erupt-ai/erupt-ai-claw</module>
        <module>erupt-ai/erupt-ai-staff</module>
        <module>erupt-ai/erupt-ai-canvas</module>
        <module>erupt-ai/erupt-ai-rag</module>

        <!-- Support (shared capabilities) -->
        <module>erupt-support/erupt-toolkit</module>
        <module>erupt-support/erupt-excel</module>
        <module>erupt-support/erupt-websocket</module>

        <!-- Plugin -->
        <module>erupt-plugin/erupt-report</module>
        <module>erupt-plugin/erupt-designer</module>
        <module>erupt-plugin/erupt-job</module>
        <module>erupt-plugin/erupt-generator</module>
        <module>erupt-plugin/erupt-monitor</module>
        <module>erupt-plugin/erupt-magic-api</module>
        <module>erupt-plugin/erupt-notice</module>
        <module>erupt-plugin/erupt-print</module>
        <module>erupt-plugin/erupt-terminal</module>
        <module>erupt-plugin/erupt-remote</module>

        <!-- Cloud -->
        <module>erupt-cloud/erupt-cloud-common</module>
        <module>erupt-cloud/erupt-cloud-server</module>
        <module>erupt-cloud/erupt-cloud-node</module>
        <module>erupt-cloud/erupt-cloud-node-jpa</module>

        <!-- Test / Sample / Deploy -->
        <module>erupt-test</module>
        <module>erupt-sample</module>
        <module>erupt-deploy/erupt-docker</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.19.0</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-parent</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-tree</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-analysis</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-commons</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-util</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>${jetbrains.annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>utf-8</encoding>
                    <compilerArgs>
                        <compilerArg>-parameters</compilerArg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.44</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring.boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <properties>
                <central.autoPublish>false</central.autoPublish>
                <central.waitUntil>uploaded</central.waitUntil>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <configuration>
                            <updatePomFile>true</updatePomFile>
                            <flattenMode>oss</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>flatten</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>flatten.clean</id>
                                <phase>clean</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Both default to the plugin's behaviour (manual publish in the Central
                                 Portal, return once uploaded); scripts/release.sh overrides them with
                                 -Dcentral.autoPublish=true -Dcentral.waitUntil=validated -->
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <waitUntil>${central.waitUntil}</waitUntil>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>2.2.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Javadoc -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <doclint>none</doclint>
                            <detectOfflineLinks>false</detectOfflineLinks>
                            <failOnError>false</failOnError>
                            <javadocExecutable>
                                ${java.home}/bin/javadoc
                            </javadocExecutable>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- GPG -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>1.6</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
