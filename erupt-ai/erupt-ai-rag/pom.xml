<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>xyz.erupt</groupId>
        <artifactId>erupt</artifactId>
        <version>2.1.1</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>erupt-ai-rag</artifactId>
    <name>Erupt : AI RAG</name>
    <description>Knowledge base and retrieval-augmented generation for erupt-ai — vector stores (Qdrant / Milvus / in-memory), document ingestion and semantic retrieval.</description>

    <dependencies>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-upms</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-ai</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- Vector store SDKs are optional: add the one matching your deployment -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-qdrant</artifactId>
            <version>${langchain4j.version}-beta24</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-milvus</artifactId>
            <version>${langchain4j.version}-beta24</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-pgvector</artifactId>
            <version>${langchain4j.version}-beta24</version>
            <optional>true</optional>
        </dependency>
        <!-- Redis 8 vector sets (VADD/VSIM) via Jedis; the spring-boot managed jedis version predates vector set support -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>6.2.0</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
